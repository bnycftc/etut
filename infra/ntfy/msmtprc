# /etc/msmtprc — mail backup of the operator alerts (alert.sh), installed by 09-ntfy.sh (600, root).
# Placeholders come from /etc/etut/etut.conf; the password stays in /etc/etut/secrets/smtp-password
# (600, root) and is read at send time. Use a mailbox at a provider in Turkey (the alert carries
# counts only, but the channel stays domestic).
defaults
auth on
tls on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
syslog LOG_MAIL

account etut
host <ALERT_SMTP_HOST>
port <ALERT_SMTP_PORT>
tls_starttls <ALERT_SMTP_STARTTLS>
from <ALERT_MAIL_FROM>
user <ALERT_SMTP_USER>
passwordeval "cat /etc/etut/secrets/smtp-password"

account default : etut
