{
  "expo": {
    "name": "Etüt",
    "slug": "etut",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "etut",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.bnycftc.etut",
      "appleTeamId": "26322AY3MH",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "tr",
        "CFBundleLocalizations": ["tr"]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1", "1C8F.1"]
          }
        ]
      }
    },
    "android": {
      "package": "com.bnycftc.etut",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/with-etut-ios.js",
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F6FEB",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.bnycftc.etut.ExpoWidgetsTarget",
          "groupIdentifier": "group.com.bnycftc.etut",
          "enablePushNotifications": false,
          "frequentUpdates": false,
          "widgets": [
            {
              "name": "EtutToday",
              "displayName": "Etüt: Bugün",
              "description": "Bugünkü çalışma süren, serin ve günlük hedefin.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium", "accessoryRectangular"]
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
